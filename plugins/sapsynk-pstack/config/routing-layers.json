      "model": "gpt-6-astra",
      "alternative_layer": "native_file_lane",
      "bounded_routine_judgment_prose": "prefer-sol-high",
      "difficult_or_ambiguous_tasks": "astra-when-task-evaluation-warrants-cost",
      "applies_to": "every-astra-slot-including-panels-and-explainer",
      "decision_timing": "explicit-task-choice-before-dispatch",
      "record": [
        "task_evaluation",
        "selected_binding",
        "selection_reason"
      ],
      "preserve": [
        "panel_entry_count",
        "candidate_independence",
        "judging_order",
        "capability_requirements"
      ],
      "provider_failure": "stop-no-silent-fallback"
    },
    "effort_escalation": {
      "optional_efforts": [
        "high",
        "xhigh"
      ],
      "requires": [
        "task_evaluation_justifies_effort",
        "discovered_model_effort",
        "role_capabilities",
        "explicit_selection"
      ],
      "default_change": false,
      "provider_failure": "stop-no-silent-fallback"
    }
