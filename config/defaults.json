  "providers": {
    "claude": {
      "executable": "claude",
      "transport": "claude-code"
    },
    "grok": {
      "executable": "grok",
      "transport": "grok-build",
      "dialect": {
        "id": "grok-build-1",
        "confinement": "response-only"
      }
    },
    "codex": {
      "executable": "codex",
      "transport": "codex-cli"
    }
  },
  "capability_policy": {
    "missing_provider": "unavailable-lane",
    "provider_fallback": "explicit-only",
    "cross_family_review": "requires-successful-real-provider-runs",
    "separate_vms": "requires-host-backend",
    "unattended_continuation": "requires-verified-scheduler-delivery"
  },
  "execution_policy": {
    "token_conservative": true,
    "subagents": "minimum sufficient for the task while honoring required workflow steps"
  }
